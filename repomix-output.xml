  const filter: any = {}

  if (articleId) {
    filter.articleId = articleId
  } else if (pinId) {
    // ⚠️ 注意：通常 Pin 的评论存在 PinComment 表里
    // 如果你确定要在这里查，请确保 Comment 模型里有 pinId 字段
