          </div>
          <NuxtLink to="/user/lottery" class="btn-draw">去抽奖</NuxtLink>
        </div>

        <div class="task-section">
          <h3 class="section-title">获取渠道</h3>

          <div class="task-list">
            <div v-for="(item, index) in tasks" :key="index" class="task-item">
