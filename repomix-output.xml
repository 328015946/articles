              </div>

              <!-- ★★★ 修改这里：按钮状态控制 ★★★ -->
              <!-- 如果是签到任务 且 isSignedToday 为 true，则显示“已签到”并应用 disabled 样式 -->
              <button
                class="btn-task"
                :class="{ signed: item.action === 'sign' && myStats?.isSignedToday }"
                @click="handleTask(item)">
                {{ item.action === 'sign' && myStats?.isSignedToday ? '已签到' : item.btnText }}
