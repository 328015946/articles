          <!-- 动态文案 -->
          <div class="label">{{ isAdmin ? '全站文章' : '我的文章' }}</div>
          <div class="value">{{ stats?.overview?.articles || 0 }}</div>
        </div>
      </div>

      <!-- 2. 用户卡片 (只有管理员可见) -->
      <div v-if="isAdmin" class="stat-card green">
        <div class="icon">👥</div>
        <div class="info">
