  }

  const [list, total] = await Promise.all([
    User.find(filter)
      .select('-password') // 不返回密码
      .sort({ createdAt: -1 })
      .skip((Number(page) - 1) * limit)
      .limit(limit),
    User.countDocuments(filter)
  ])

  return { list, total }
})
