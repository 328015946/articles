              </label>
              <label :class="{ active: megaStyle === 'urgent' }" class="urgent-label">
                <input type="radio" value="urgent" v-model="megaStyle" hidden /> 红色加急 (1000币)
              </label>
            </div>

            <button class="btn-send" @click="sendMegaphone">立即发送</button>
          </div>
        </div>
      </main>
